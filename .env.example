# Copy to .env and adjust for your environment. docker compose loads .env automatically.
DB_NAME=commutesync
DB_USER=commutesync
DB_PASSWORD=change-me-in-production

# Must be at least 32 bytes for HS256. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=3600000
